# Copy to .env (repo root) and fill in. The app runs end-to-end with everything empty
# (SOURCE_MODE=mock + deterministic LLM fallback).

# mock | cache | apify
SOURCE_MODE=mock
# Runtime data (cache/, runs/, llm/). Default: <repo>/data
DATA_DIR=
# Mock dataset. Default: <repo>/fixtures
FIXTURES_DIR=
# ---- LLM ------------------------------------------------------------------------------------
# auto | anthropic | openrouter. auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenRouter if
# OPENROUTER_API_KEY is set, else every LLM task uses its labeled deterministic fallback.
LLM_PROVIDER=auto
# Claude (Anthropic API)
ANTHROPIC_API_KEY=
# Claude API base URL. Always passed explicitly, so a stray ANTHROPIC_BASE_URL exported by another
# tool in your shell cannot redirect our calls. Default https://api.anthropic.com
LLM_BASE_URL=
MODEL_CHAT=claude-opus-5-5
MODEL_BULK=claude-sonnet-5-5
# OpenRouter (OpenAI-compatible; free models end in ":free"). Key: https://openrouter.ai/keys
# Free tier: ~20 requests/min (we stay at 18) and a small daily cap without purchased credits
# (check yours: GET https://openrouter.ai/api/v1/key). Czech quality varies between free models.
OPENROUTER_API_KEY=
# Defaults work with OPENROUTER_DATA_COLLECTION=deny. nvidia/nemotron-3-super-120b-a12b:free (tools + structured
# output too) is only served with "allow" plus "Free model training" enabled at
# https://openrouter.ai/settings/privacy, because its free endpoint may train on prompts.
OPENROUTER_MODEL_CHAT=dots-studio/dots-3-note-preview:free
OPENROUTER_MODEL_BULK=dots-studio/dots-3-note-preview:free
# Tried in order when the primary fails (comma list; at most 2 are used)
OPENROUTER_FALLBACK_MODELS=apodex/apodex-1.1-mini:free,openrouter/free
# deny | allow. "deny" only routes to providers that do not log or train on prompts. Some free
# providers need "allow" (and the matching privacy setting on your OpenRouter account), which means
# prompts may be stored or used for training. We send real public creator data (captions, bios,
# comments), so keep "deny" unless no provider answers.
OPENROUTER_DATA_COLLECTION=deny
# Task groups OpenRouter may serve (comma list): chat, vetting (claims, skeptic, questions, outreach),
# news (news labels), topics, sensitive. "all" = every group, "none" = no LLM task. Groups left out
# use their labeled deterministic fallback. Default chat,vetting,news: topics and the sensitive filter
# are rule-based, so a subject check costs at most 5 bulk requests. Anthropic ignores this (all tasks).
# (OPENROUTER_BULK_TASKS is deprecated: 1 = "all" when this is unset; 0 is ignored.)
OPENROUTER_TASKS=chat,vetting,news
# ---- LLM request budget -----------------------------------------------------------------------
# Max LLM HTTP requests per process, for either provider. Empty: 40 with OpenRouter (the free daily
# cap is small and shared with the chat), unlimited with Anthropic. 0 = no LLM requests;
# unlimited / off / -1 = no cap. Cached answers (data/llm/) cost nothing, and switching the goal
# re-renders the report without requests. GET /api/health shows llm_requests_used / llm_budget.
LLM_REQUEST_BUDGET=
# Empty -> no live Apify calls (Kryštof's provider)
APIFY_TOKEN=
# Apify cost cap per actor run in USD (estimate above it -> run skipped). Default 3
MAX_USD_PER_RUN=3
# Optional Apify switches (docs/apify-pro-krystofa.md, "Datový kontrakt s aplikací"):
# APIFY_PLACES=1                  # also discover via IG places in the city (T2 + T4)
# APIFY_POST_DETAIL=basicData     # if post-scraper charges music-data (default detailedData)
# APIFY_COMMENTS_SOURCE=latest    # comments from post-scraper latestComments (default comments)
# APIFY_TIKTOK_PROXY=None         # drop the paid CZ proxy add-on (default CZ)
# Fake latency per mock provider call, seconds
MOCK_LATENCY=0.15
